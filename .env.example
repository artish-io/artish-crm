# Shared password for the whole app. Login is disabled (fails closed) if this or SESSION_SECRET is missing.
CRM_PASSWORD=
# 32+ random characters used to sign the session cookie:  openssl rand -hex 32
SESSION_SECRET=

# Read-only access to the main Artish Postgres (analytics + sync). Use a role with SELECT only.
# Production (Vercel): Cloud SQL connector with a service account.
CLOUD_SQL_INSTANCE=project:region:instance
DB_USER=
DB_PASSWORD=
DB_NAME=
# Service account JSON (single line) with the "Cloud SQL Client" role.
GCP_SERVICE_ACCOUNT_KEY=
# Local dev alternative (needs your IP on the instance's authorized networks):
# MAIN_DATABASE_URL=postgres://user:pass@host:5432/db

# The CRM's own database (contacts, notes, later: email rules + send log). Neon via the Vercel Marketplace sets this.
# Leave unset for local dev: an embedded Postgres is kept in ./.data/pglite instead.
DATABASE_URL=

# Vercel Blob (private store), used only for uploaded transcript files. Added when you connect a store.
# Leave unset for local dev: files are then kept in ./.data/uploads.
BLOB_READ_WRITE_TOKEN=

# Email automation (Resend). Dry run needs none of these; going live needs the first three.
RESEND_API_KEY=
EMAIL_FROM="Artish <hello@your-verified-domain.com>"
CRM_BASE_URL=https://your-crm.vercel.app
# Optional reply-to address
EMAIL_REPLY_TO=
# Random string; Vercel Cron sends it so only Vercel can trigger /api/cron/automation
CRON_SECRET=
