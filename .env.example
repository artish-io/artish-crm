# Shared password for the whole app. Login is disabled (fails closed) if this or SESSION_SECRET is missing.
CRM_PASSWORD=
# 32+ random characters used to sign the session cookie:  openssl rand -hex 32
SESSION_SECRET=

# The main Artish app, used by "Sync" to pull signups, last sign-in and the feature checklist.
MAIN_APP_URL=https://your-main-app.example.com
# The main app's existing admin dashboard password (ADMIN_DASHBOARD_PASSWORD there).
MAIN_APP_ADMIN_PASSWORD=

# Vercel Blob (private store). Added automatically when you connect a store to the project.
# Leave unset for local dev: data is then kept in ./.data instead.
BLOB_READ_WRITE_TOKEN=
